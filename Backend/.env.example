# Copy this file to .env and fill in the values. Never commit .env.

# Port the server listens on (Render sets this for you)
PORT=4000

# Supabase project (Project Settings > API Keys)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Groq (console.groq.com > API Keys). Server only: never put it in the app.
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=openai/gpt-oss-20b
# Answering by voice (speech to text) and by handwriting (a vision model).
# Check console.groq.com/docs/models if Groq renames them.
GROQ_SPEECH_MODEL=whisper-large-v3-turbo
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Which websites may call the API (comma separated). * allows all.
# The phone app doesn't need this; it's for the web version.
ALLOWED_ORIGINS=*
