# Copy this file to .env. Only EXPO_PUBLIC_ values are built into the app,
# so never put secret keys (like the Groq key) here.

# Supabase project (Project Settings > API Keys > publishable key)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# The backend (Backend folder). On a phone, localhost is the phone itself:
# use your computer's network address (e.g. http://192.168.1.20:4000)
# while testing, and the Render address once it's hosted.
EXPO_PUBLIC_API_URL=http://localhost:4000
